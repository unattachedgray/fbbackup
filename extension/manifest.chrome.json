{
  "manifest_version": 3,
  "name": "fbbackup scanner",
  "version": "0.1.0",
  "description": "Scan your Facebook posts into your local fbbackup archive as you scroll. Stops on its own at the posts you already have.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.trycloudflare.com/*",
    "https://*.unattached.me/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["scan.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "fbbackup scanner"
  }
}
